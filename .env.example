# Copy to .env.local for local dev. Production values live in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=            # Neon Postgres (leads, bookings, funnel events)
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (lead photo uploads)
NEXT_PUBLIC_GA_ID=       # GA4 measurement ID (falls back to G-JHH1X8LD8E in lib/analytics.ts)
NEXT_PUBLIC_META_PIXEL_ID=   # falls back to 1089287971750305
NEXT_PUBLIC_OPENAI_PIXEL_ID= # optional
OPENAI_ADS_API_KEY=      # optional — enables /api/conversions/openai
INDEXNOW_SECRET=         # optional — protects /api/indexnow
